{
    "name": "tempest/mcp",
    "description": "The PHP framework that gets out of your way.",
    "require": {
        "php": "^8.5",
        "tempest/console": "3.19.2",
        "tempest/container": "3.19.2",
        "tempest/core": "3.19.2",
        "tempest/discovery": "3.19.2",
        "tempest/http": "3.19.2",
        "tempest/mapper": "3.19.2",
        "tempest/reflection": "3.19.2",
        "tempest/router": "3.19.2",
        "tempest/support": "3.19.2",
        "tempest/validation": "3.19.2"
    },
    "autoload": {
        "psr-4": {
            "Tempest\\Mcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tempest\\Mcp\\Tests\\": "tests"
        }
    },
    "license": "MIT",
    "minimum-stability": "dev"
}
