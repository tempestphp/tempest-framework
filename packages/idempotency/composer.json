{
    "name": "tempest/idempotency",
    "description": "Idempotency support for Tempest applications.",
    "type": "library",
    "require": {
        "php": "^8.5",
        "tempest/cache": "3.19.3",
        "tempest/container": "3.19.3",
        "tempest/datetime": "3.19.3",
        "tempest/http": "3.19.3",
        "tempest/router": "3.19.3",
        "tempest/support": "3.19.3",
        "tempest/command-bus": "3.19.3",
        "tempest/core": "3.19.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Tempest\\Idempotency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tempest\\Idempotency\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev"
}
